# ---------------------------------------------------------------------------
# Claim Ledger frontend — environment variables (all public, NO secrets here).
# Copy to .env.local and adjust:  cp .env.example .env.local
# The LLM is only ever called by the backend — never from this client.
# ---------------------------------------------------------------------------

# Base URL of the Claim Ledger backend API (no trailing slash).
VITE_API_BASE_URL=http://localhost:4000

# Development aid only: set to "1" to run against the in-browser mock adapter
# (fictional seeded data, no backend needed). This flag is IGNORED in
# production builds — production never uses mock data.
VITE_USE_MOCK=1
