# Claim Ledger AI Evaluation Environment Configuration

# Provider selection: 'mock', 'gemini' (or 'google'), 'openai', 'groq'
LLM_PROVIDER=mock

# Model name:
# For mock: mock-claim-engine-v1
# For Gemini: gemini-2.5-flash
# For OpenAI: gpt-4o-mini
LLM_MODEL=mock-claim-engine-v1

# API Key: NEVER commit your actual API key to version control.
# Not required when LLM_PROVIDER=mock
LLM_API_KEY=your_api_key_here
